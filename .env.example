# URL del evento a monitorear
EVENT_URL=https://www.ticketmaster.co/event/bts-world-tour-venta-general-viernes-2-octubre

# Bot de Telegram (crear con @BotFather -> /newbot)
TELEGRAM_BOT_TOKEN=

# Uno o varios chat ids separados por coma (cada persona debe escribirle
# primero al bot; luego consulta https://api.telegram.org/bot<TOKEN>/getUpdates
# y toma "chat":{"id": ...} de cada uno)
TELEGRAM_CHAT_ID=

# Segundos base entre cada verificación (se le suma un jitter aleatorio)
POLL_INTERVAL_SECONDS=240

# Jitter aleatorio máximo en segundos, sumado al intervalo base
POLL_JITTER_SECONDS=90

# Cada cuántas horas enviar un mensaje de "sigo vivo" a Telegram (0 = desactivado)
HEARTBEAT_HOURS=0.5

# Ruta del archivo de estado persistente
STATE_FILE=state.json

# Carpeta donde se guarda el perfil/sesión persistente del navegador
BROWSER_STATE_DIR=browser_state

# Carpeta donde se guardan snapshots de HTML cuando el estado es "blocked_unknown" o "unknown"
SNAPSHOT_DIR=debug_snapshots
